# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

MC_VERSION=LATEST
TZ=America/Los_Angeles
MOTD=A Paper server
MAX_PLAYERS=20

# Comma-separated Minecraft usernames
WHITELIST=YourName,Friend1
OPS=YourName

# Generate with: openssl rand -hex 16
RCON_PASSWORD=change-me

# --- Off-platform backups (restic) ---
# Pick a provider that is NOT Oracle. Backblaze B2 example:
RESTIC_REPOSITORY=b2:your-bucket-name:mc-server
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# S3-compatible alternative (R2, Wasabi, AWS):
#   RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/mc-server
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=

# Encrypts the backups. LOSE THIS AND THE BACKUPS ARE UNRECOVERABLE.
# Store a copy in your password manager.
RESTIC_PASSWORD=change-me-too
