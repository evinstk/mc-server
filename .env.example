# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

MC_VERSION=LATEST
# Heap size. 10G on the Oracle box; use 2G-3G for local testing
# (Docker Desktop's VM defaults to far less than 10G).
MC_MEMORY=10G
TZ=America/Los_Angeles
MOTD=A Paper server
MAX_PLAYERS=20

# Comma-separated Minecraft usernames
WHITELIST=YourName,Friend1
OPS=YourName

# Generate with: openssl rand -hex 16
RCON_PASSWORD=change-me

# --- Off-platform backups (restic) ---
# Google Cloud Storage. Service account key goes in ./secrets/gcs-key.json
RESTIC_REPOSITORY=gs:your-bucket-name:/mc-server
GOOGLE_PROJECT_ID=your-gcp-project-id

# Encrypts the backups. LOSE THIS AND THE BACKUPS ARE UNRECOVERABLE.
# Store a copy in your password manager.
RESTIC_PASSWORD=change-me-too

# --- BlueMap public web login (served by Caddy at https://minecraft.tannerevins.com) ---
MAP_USER=yourname
# Generate with: docker run --rm caddy caddy hash-password
# Keep the single quotes: the hash contains $ characters.
MAP_PASSWORD_HASH='change-me'
